{
  "manifest_version": 3,
  "name": "네이버 블로그 이미지 다운로더",
  "version": "0.2.1",
  "description": "네이버 블로그 본문 이미지를 미리보고 선택하여 고해상도 w3840 우선으로 저장합니다.",
  "minimum_chrome_version": "120",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "permissions": ["storage", "downloads", "alarms", "activeTab"],
  "host_permissions": ["https://blog.naver.com/*", "https://m.blog.naver.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "네이버 블로그 이미지 저장", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "content_scripts": [{
    "matches": ["https://blog.naver.com/*", "https://m.blog.naver.com/*"],
    "js": ["core.js", "content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' https://*.pstatic.net https://pstatic.net https://blogfiles.naver.net https://postfiles.naver.net; style-src 'self'"
  }
}
